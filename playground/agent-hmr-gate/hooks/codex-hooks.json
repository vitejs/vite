{
  "description": "Batch Vite updates around each Codex turn.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/playground/agent-hmr-gate/hooks/hmr-gate-hook.mjs\" begin",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/playground/agent-hmr-gate/hooks/hmr-gate-hook.mjs\" flush",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/playground/agent-hmr-gate/hooks/hmr-gate-hook.mjs\" flush",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
